# Application Configuration
APP_NAME="VoiceTaskManager"
APP_ENV=development
APP_PORT=8000
APP_HOST=localhost
APP_URL=http://localhost:8000

# Database Configuration
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=voicetaskmanager
DB_USER=postgres
DB_PASSWORD=password
DB_SSL=false

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your-refresh-jwt-secret-here
JWT_REFRESH_EXPIRES_IN=7d

# Ollama Configuration
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Security Configuration
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Audio/Transcription Settings
AUDIO_MAX_SIZE=50mb
TRANSCRIPTION_TIMEOUT=30000

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

# Feature Flags
FEATURE_VOICE_TRANSCRIPTION=true
FEATURE_TASK_COMPLETION=true
FEATURE_REALTIME_UPDATES=true