# Application
APP_NAME=VoiceAssistantPlatform
APP_ENV=development
PORT=8000
HOST=localhost

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=voice_assistant_db
DB_USER=voice_user
DB_PASSWORD=voice_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# Security
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info

# Ollama (for AI features)
OLLAMA_HOST=localhost
OLLAMA_PORT=11434

# Voice Processing
VOICE_SAMPLE_RATE=16000
VOICE_CHANNELS=1
VOICE_BIT_DEPTH=16

# Task Management
TASK_DEFAULT_PRIORITY=medium
TASK_DEFAULT_STATUS=pending