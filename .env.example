# Application Configuration
APP_NAME=voice-assistant-app
APP_ENV=development
PORT=8000
HOST=localhost

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=voice_assistant_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your-refresh-token-secret-here-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Ollama Configuration (AI Service)
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Security Configuration
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

# File Upload Configuration
MAX_FILE_SIZE=50mb
ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf,audio/wav,audio/mpeg

# WebSocket Configuration
WS_PORT=8001
WS_PATH=/ws

# Email Configuration (for future use)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Feature Flags
ENABLE_VOICE_TRANSCRIPTION=true
ENABLE_TASK_NOTIFICATIONS=true
ENABLE_REAL_TIME_SYNC=true

# Monitoring & Analytics
SENTRY_DSN=
GOOGLE_ANALYTICS_ID=